# Copy these into Vercel -> Project Settings -> Environment Variables.
# Never commit a real .env file.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/offishall?retryWrites=true&w=majority

# Long random string used to sign login tokens (e.g. run: openssl rand -hex 32)
JWT_SECRET=change-me

# SMTP settings used to email the verification code (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Offishall Stores <yourgmail@gmail.com>"
